{
  "name": "@hiraoku/react-grab-amp",
  "version": "0.0.88",
  "description": "[Experimental Fork] Amp provider for React Grab",
  "keywords": ["react-grab", "amp", "coding-agent", "fork", "experimental"],
  "homepage": "https://github.com/aidenybai/react-grab",
  "repository": {
    "type": "git",
    "url": "https://github.com/aidenybai/react-grab.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "react-grab-amp": "./dist/cli.cjs"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./dist/*": "./dist/*.js",
    "./dist/*.js": "./dist/*.js"
  },
  "browser": "dist/client.global.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "rm -rf dist && NODE_ENV=production tsup"
  },
  "devDependencies": {
    "@hiraoku/react-grab-utils": "workspace:*",
    "@types/node": "^22.10.7",
    "tsup": "^8.4.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.6",
    "execa": "^9.6.0",
    "@sourcegraph/amp-sdk": "0.1.0-20251210081226-g90e3892",
    "fkill": "^9.0.0",
    "hono": "^4.0.0",
    "picocolors": "^1.1.1",
    "@hiraoku/react-grab": "workspace:*"
  }
}
