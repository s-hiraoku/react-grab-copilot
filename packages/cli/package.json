{
  "name": "@hiraoku/react-grab-cli",
  "version": "0.0.88",
  "description": "[Experimental Fork] CLI for React Grab",
  "keywords": ["react-grab", "cli", "fork", "experimental"],
  "homepage": "https://github.com/aidenybai/react-grab",
  "repository": {
    "type": "git",
    "url": "https://github.com/aidenybai/react-grab.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "@hiraoku/react-grab": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "rm -rf dist && NODE_ENV=production tsup",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "tsup": "^8.4.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@antfu/ni": "^0.23.0",
    "commander": "^14.0.0",
    "http-proxy-middleware": "^3.0.3",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2"
  }
}
