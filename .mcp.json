{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "deepgraph-react": {
      "command": "npx",
      "args": ["-y", "@anthropic/deepgraph-react-mcp"]
    },
    "deepgraph-nextjs": {
      "command": "npx",
      "args": ["-y", "@anthropic/deepgraph-nextjs-mcp"]
    },
    "deepgraph-typescript": {
      "command": "npx",
      "args": ["-y", "@anthropic/deepgraph-typescript-mcp"]
    }
  }
}
