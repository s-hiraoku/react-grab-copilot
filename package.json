{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter=@hiraoku/react-grab --filter=@hiraoku/react-grab-cursor --filter=@hiraoku/react-grab-claude-code --filter=@hiraoku/react-grab-ami --filter=@hiraoku/react-grab-opencode --filter=@hiraoku/react-grab-codex --filter=@hiraoku/react-grab-gemini --filter=@hiraoku/react-grab-amp --filter=@hiraoku/react-grab-copilot --filter=@hiraoku/react-grab-cli --filter=@hiraoku/react-grab-utils --filter=@hiraoku/react-grab-visual-edit && pnpm --filter @hiraoku/grab build",
    "dev": "turbo dev --filter=@hiraoku/react-grab --filter=@hiraoku/react-grab-cursor --filter=@hiraoku/react-grab-claude-code --filter=@hiraoku/react-grab-ami --filter=@hiraoku/react-grab-opencode --filter=@hiraoku/react-grab-codex --filter=@hiraoku/react-grab-gemini --filter=@hiraoku/react-grab-amp --filter=@hiraoku/react-grab-copilot --filter=@hiraoku/react-grab-cli --filter=@hiraoku/react-grab-utils --filter=@hiraoku/react-grab-visual-edit",
    "lint": "pnpm --filter @hiraoku/react-grab lint",
    "lint:fix": "pnpm --filter @hiraoku/react-grab lint:fix",
    "format": "prettier --write .",
    "check": "pnpm --filter @hiraoku/react-grab check",
    "changeset": "changeset",
    "version": "changeset version",
    "prebump": "cp README.md packages/react-grab/README.md && pnpm --filter @hiraoku/grab build",
    "bump": "changeset && changeset version",
    "release": "pnpm build && changeset publish",
    "release:beta": "pnpm build && changeset publish --tag beta",
    "extension:dev": "pnpm --filter @hiraoku/react-grab-web-extension dev",
    "extension:build": "pnpm --filter @hiraoku/react-grab-web-extension build"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10",
    "prettier": "^3.4.2",
    "turbo": "^2.6.3",
    "untun": "^0.1.3"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@10.24.0",
  "workspaces": [
    "packages/*",
    "packages/benchmarks/next-app"
  ]
}
